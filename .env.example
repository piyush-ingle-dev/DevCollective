# Client
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional: full public WebSocket base URL for remote/tunnel testing, e.g. wss://your-ws-tunnel.example.com
VITE_WS_URL=
VITE_WS_PORT=3001

# Server
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Optional comma-separated origins used to validate Clerk session tokens over WebSocket.
# Example: http://localhost:3000,http://192.168.137.1:3000
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_key
WS_PORT=3001
# Access control
COLLEGE_EMAIL_DOMAIN=ghrietn.raisoni.net
# Comma-separated exact administrator emails.
ADMIN_EMAILS=raat131221@gmail.com,kanojiyapk524@gmail.com

# Supabase Edge Function: events admin JWT verification
# Use the Clerk Frontend API / issuer URL shown in Clerk Dashboard.
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
# Optional comma-separated Clerk authorized-party origins for event mutations.
EVENTS_CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://devcollective-app.onrender.com

# Existing DevCollective services
GEMINI_API_KEY=your_gemini_key
APP_URL=http://localhost:3000

# Mentor application email is server-side only.
MENTOR_APPLICATION_EMAIL=devcollective0@gmail.com

# Transactional email (Supabase Edge Functions / Brevo)
BREVO_API_KEY=your_brevo_key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=DevCollective
# Supabase Edge Function CORS allowlist, comma-separated.
MENTOR_ALLOWED_ORIGINS=http://localhost:3000,https://devcollective-app.onrender.com
